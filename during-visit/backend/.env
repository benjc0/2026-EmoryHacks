# ---- Gemini (required) ----
GEMINI_API_KEY=

# Main model for notes/summaries. gemini-3.8-flash was overloaded/out of quota for you,
# so start with the one that's been answering:
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Tried in order if the main model is busy (503), out of quota (429) or missing
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.8-flash
# Summary model (gemini-2.5-flash-lite = fastest)
# GEMINI_SUMMARY_MODEL=gemini-2.5-flash-lite
# How much the models "think": minimal | low | medium | default (lower = faster)
GEMINI_THINKING=low
# Seconds to wait on one request before trying the next model
GEMINI_REQUEST_TIMEOUT_SEC=20
# Seconds "End visit" waits before showing the notes (summary fills in after)
SUMMARY_WAIT_SEC=8
# How often notes refresh during the visit (seconds)
EXTRACT_EVERY_SEC=30

# Live interpreter model
LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview

# ---- Typesense (leave TYPESENSE_HOST empty to run without it) ----
TYPESENSE_HOST=7tzejad3k9v20si8p-1.a1.typesense.net
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=DsvH5JdiNOgPCs8vFgNgnpRp3J8Q185g
# Multilingual model needs ~1.5 GB RAM on the cluster; set to off on a small/free cluster
TYPESENSE_EMBED_MODEL=off

# ---- Backups ----
# Where visit JSON backups go (default: backend\data)
# DATA_DIR=

#To Dashboard
PT_APP_DIR=C:\dev\2026-EmoryHacks\after-visit