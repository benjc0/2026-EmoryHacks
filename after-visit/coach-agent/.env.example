# Fill these in privately. All three LiveKit values must belong to one project.
# On a Shared plan with Chert rooms, leave all three empty (LIVEKIT_URL=): calls then run in Chert's LiveKit.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Gemini API key (free): https://aistudio.google.com/apikey
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=emory-pt-coach

# "Call my iPhone" (npm run call-server). Keep these private.
# Chert project API key: make one at https://app.trychert.com/developer (starts with ftk_).
CHERT_API_KEY=YOUR_CHERT_API_KEY
# Chert project and line IDs: shown on the line page in the Chert console.
CHERT_PROJECT_ID=YOUR_CHERT_PROJECT_ID
CHERT_LINE_ID=YOUR_CHERT_LINE_ID
# The verified iPhone the coach calls, as + and digits (for example +1 then 10 digits).
COACH_PATIENT_PHONE=YOUR_PATIENT_PHONE

# Optional
# COACH_DIAGNOSTICS=1        log the caller's voice level (use when the coach doesn't react to the caller)
# COACH_POSE=off             turn body tracking off
# CHERT_API_BASE=https://app.trychert.com
# POSE_RUNTIME=wsl           Windows default; "native" runs pose/.venv on this machine (see pose/README.md)
